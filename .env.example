# =============================================================================
# Patientia API Client Environment Configuration
# =============================================================================

# API Connection Settings
API_BASE_URL=http://localhost:8000
API_TIMEOUT=30
MAX_FILE_SIZE_MB=100

# LLM Provider Settings (for API backend)
# Default provider: Google Gemini. Set your API key and (optionally) the model.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Pick a model your credits cover (e.g. gemini-3.8-flash, gemini-3.8-pro)
GEMINI_MODEL=gemini-3.8-flash

# Optional alternative providers (used only if LLM_PROVIDER points to them)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Streamlit Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# Auth Settings (JWT username/password)
# AUTH_SECRET_KEY: fija una clave estable para que los tokens sobrevivan reinicios.
AUTH_SECRET_KEY=change_me_in_production
# AUTH_USERS: pares usuario:contraseña separados por comas. Si se omite, se crea
# un usuario de desarrollo doctor/patientia.
AUTH_USERS=doctor:patientia
AUTH_TOKEN_TTL_MIN=480

# Debug Settings
DEBUG=true
LOG_LEVEL=INFO
